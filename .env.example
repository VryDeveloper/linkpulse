# Banco de dados. O padrão é o Postgres local embutido do Prisma (`npm run setup` sobe ele sozinho).
# Para usar outro Postgres (Neon, Supabase, Docker…), troque pela URL dele.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# Segredo usado para pseudonimizar IPs (sha256). O `npm run setup` gera um automaticamente.
IP_HASH_SALT=""

# Opcional, só em dev. Rodando local, o clique chega como 127.0.0.1; por padrão o app descobre
# sozinho o IP público da sua máquina e usa a localização real. Preencha só se quiser SIMULAR
# um clique vindo de outro IP/lugar.
GEO_DEV_IP=""

# Opcional: URL pública usada para montar os links curtos (ex: https://lnk.exemplo.com)
NEXT_PUBLIC_BASE_URL=""

# Senha do painel (lista de links e analytics). Obrigatória em produção: sem ela o painel fica bloqueado.
# Em desenvolvimento, deixe vazio para acessar sem senha. Usuário padrão: admin (mude com ADMIN_USER).
ADMIN_PASSWORD=""
ADMIN_USER=""

# Opcional: slug do link curto usado na demo pública (/demo). Padrão: ao-vivo
DEMO_SLUG=""
