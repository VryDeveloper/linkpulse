generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id         String   @id @default(cuid())
  slug       String   @unique
  url        String
  title      String?
  /// Quando true, o redirect passa por uma página que pede a localização GPS (com consentimento).
  preciseGeo Boolean  @default(false)
  createdAt  DateTime @default(now())
  clicks     Click[]
}

model Click {
  id        String   @id
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// IP público do dispositivo que clicou.
  ip     String?
  /// SHA-256 do IP + salt: usado para contar visitantes únicos.
  ipHash String

  // Geolocalização aproximada pelo IP (precisão de cidade)
  geoSource   String? // "edge-headers" | "ipwho.is" | "none"
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  postalCode  String?
  timezone    String? // fuso horário do local do IP, ex: America/Sao_Paulo
  isp         String? // provedor de internet (ex: Claro, Vivo)
  asn         Int? // número do sistema autônomo da rede

  // Geolocalização precisa (Geolocation API do navegador, só com consentimento)
  preciseLatitude  Float?
  preciseLongitude Float?
  preciseAccuracy  Float? // raio em metros
  preciseStatus    String? // "granted" | "denied" | "unavailable" | "timeout"

  // Contexto técnico
  device         String // "desktop" | "mobile" | "tablet" | "bot" | ...
  deviceVendor   String? // ex: Apple, Samsung
  deviceModel    String? // ex: iPhone, SM-S918B
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  referrerHost   String?
  referrer       String?
  language       String?
  userAgent      String?
  isBot          Boolean @default(false)

  @@index([linkId, createdAt])
  @@index([linkId, countryCode])
}
